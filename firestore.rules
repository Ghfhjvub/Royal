rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function isWorker() { return signedIn() && profile().role == 'worker'; }
    function isStaff() { return isAdmin() || isWorker(); }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isWorker() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'price', 'img', 'updatedAt', 'updatedBy']));
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name','phone','delivery','notes','items','total','status','createdAt','time'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.status == 'جديد' &&
        request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','updatedAt','updatedBy']) &&
        request.resource.data.status in ['جديد','قيد التحضير','جاهز','مكتمل','ملغي'];
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isStaff() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['admin','worker'];
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }
  }
}
